  <diagram id="pangi-repository-structure" name="E. Repository 파일 배치 View">
    <mxGraphModel dx="1900" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="p5-0"/>
        <mxCell id="p5-1" parent="p5-0"/>
        <mxCell id="p5-title" value="View E · Pangi 최종 Repository / Package 배치" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#17212B;" vertex="1" parent="p5-1"><mxGeometry x="50" y="35" width="1300" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-subtitle" value="파일 위치가 책임과 의존 방향을 드러내도록 Domain · Application · Adapter · Product Asset을 분리한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#475467;" vertex="1" parent="p5-1"><mxGeometry x="52" y="92" width="1500" height="40" as="geometry"/></mxCell>

        <mxCell id="p5-root" value="&lt;b&gt;Pangi/ · Release Root&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:16px&quot;&gt;├─ pyproject.toml / uv.lock&lt;br&gt;├─ README.md / LICENSE&lt;br&gt;├─ .gitignore&lt;br&gt;├─ src/pangi/       # Python wheel&lt;br&gt;├─ ui/              # Dashboard source&lt;br&gt;├─ tests/&lt;br&gt;├─ docs/&lt;br&gt;└─ scripts/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#667085;strokeWidth=3;fontSize=23;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;arcSize=10;" vertex="1" parent="p5-1"><mxGeometry x="50" y="165" width="380" height="350" as="geometry"/></mxCell>
        <mxCell id="p5-entry" value="&lt;b&gt;src/pangi/ · Public / Composition&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:16px&quot;&gt;├─ __init__.py      # stable exports&lt;br&gt;├─ config.py        # typed config&lt;br&gt;├─ runtime.py       # PangiRuntime facade&lt;br&gt;├─ bootstrap.py     # composition root&lt;br&gt;├─ domain/&lt;br&gt;├─ application/&lt;br&gt;├─ adapters/&lt;br&gt;├─ plugins/&lt;br&gt;├─ builtins/&lt;br&gt;└─ web/static/      # packaged UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F79009;strokeWidth=3;fontSize=23;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;arcSize=10;" vertex="1" parent="p5-1"><mxGeometry x="50" y="545" width="380" height="480" as="geometry"/></mxCell>

        <mxCell id="p5-domain" value="&lt;b&gt;domain/ · Pure Business Rules&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:16px&quot;&gt;├─ common/&lt;br&gt;│  ├─ ids.py · clock.py · errors.py&lt;br&gt;├─ runs/&lt;br&gt;│  ├─ entities.py · events.py · policies.py&lt;br&gt;├─ skills/&lt;br&gt;│  ├─ entities.py · graph.py · policies.py&lt;br&gt;├─ schedules/&lt;br&gt;│  ├─ entities.py · occurrence.py&lt;br&gt;├─ connections/&lt;br&gt;│  ├─ entities.py · policies.py&lt;br&gt;├─ evals/&lt;br&gt;│  ├─ entities.py · expectations.py&lt;br&gt;└─ memory/&lt;br&gt;   ├─ entities.py · applicability.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#53389E&quot;&gt;외부 SDK, DB, HTTP를 Import하지 않는다.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EBFF;strokeColor=#7F56D9;strokeWidth=3;fontSize=23;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;arcSize=10;" vertex="1" parent="p5-1"><mxGeometry x="465" y="165" width="430" height="575" as="geometry"/></mxCell>
        <mxCell id="p5-application" value="&lt;b&gt;application/ · Use Case / Port&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:16px&quot;&gt;├─ contracts/&lt;br&gt;│  ├─ requests.py · results.py · decisions.py&lt;br&gt;├─ ports/&lt;br&gt;│  ├─ inbound.py · model.py · connection.py&lt;br&gt;│  ├─ storage.py · secrets.py · events.py&lt;br&gt;├─ use_cases/&lt;br&gt;│  ├─ run_request.py · run_skill.py&lt;br&gt;│  ├─ manage_connection.py&lt;br&gt;│  ├─ manage_schedule.py · run_eval.py&lt;br&gt;│  └─ manage_memory.py&lt;br&gt;└─ services/&lt;br&gt;   ├─ guardrails.py · orchestrator.py&lt;br&gt;   ├─ plan_validator.py · execution_engine.py&lt;br&gt;   ├─ result_reducer.py · skill_compiler.py&lt;br&gt;   └─ policy_engine.py · analytics.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#6172F3;strokeWidth=3;fontSize=23;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;arcSize=10;" vertex="1" parent="p5-1"><mxGeometry x="930" y="165" width="475" height="680" as="geometry"/></mxCell>
        <mxCell id="p5-adapters" value="&lt;b&gt;adapters/ · Technology Boundary&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:15px&quot;&gt;├─ inbound/&lt;br&gt;│  ├─ cli.py · slack.py · scheduler.py&lt;br&gt;│  └─ api/&lt;br&gt;│     ├─ runs · connections · skills&lt;br&gt;│     └─ schedules · evals · admin · analytics&lt;br&gt;└─ outbound/&lt;br&gt;   ├─ models/&lt;br&gt;   │  └─ openai · bedrock · request_mapper&lt;br&gt;   ├─ mcp/&lt;br&gt;   │  ├─ client · oauth · discovery&lt;br&gt;   │  └─ normalizer · tool_enforcer&lt;br&gt;   ├─ persistence/sqlite/&lt;br&gt;   │  ├─ repositories · unit_of_work&lt;br&gt;   │  └─ migrations/&lt;br&gt;   ├─ secrets/&lt;br&gt;   │  └─ keyring · file_vault&lt;br&gt;   └─ telemetry/&lt;br&gt;      └─ logs · metrics · tracing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#12B76A;strokeWidth=3;fontSize=23;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;arcSize=10;" vertex="1" parent="p5-1"><mxGeometry x="1420" y="165" width="430" height="750" as="geometry"/></mxCell>

        <mxCell id="p5-product" value="&lt;b&gt;Product Assets · Plugin / UI&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:15px&quot;&gt;src/pangi/plugins/&lt;br&gt;├─ registry.py · manifests.py&lt;br&gt;└─ capability_packs.py&lt;br&gt;src/pangi/builtins/&lt;br&gt;└─ skills/ · subagents/ · evals/&lt;br&gt;src/pangi/web/static/  # packaged UI build&lt;br&gt;ui/src/&lt;br&gt;├─ app/ · components/ · features/&lt;br&gt;└─ api/ · styles/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0BA5EC;strokeWidth=3;fontSize=22;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;arcSize=10;" vertex="1" parent="p5-1"><mxGeometry x="465" y="775" width="430" height="380" as="geometry"/></mxCell>
        <mxCell id="p5-tests" value="&lt;b&gt;Verification / Documentation&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:16px&quot;&gt;tests/&lt;br&gt;├─ unit/domain/ · unit/application/&lt;br&gt;├─ contract/ · integration/ · e2e/ · fixtures/&lt;br&gt;docs/&lt;br&gt;├─ implementation-design.md · *.drawio · *.png&lt;br&gt;scripts/&lt;br&gt;├─ build_ui · release_smoke · migration_check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F3;strokeColor=#F63D68;strokeWidth=3;fontSize=22;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;arcSize=10;" vertex="1" parent="p5-1"><mxGeometry x="930" y="880" width="475" height="300" as="geometry"/></mxCell>
        <mxCell id="p5-data" value="&lt;b&gt;Runtime Data · Repository 밖&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:15px&quot;&gt;PANGI_HOME/&lt;br&gt;├─ config.toml&lt;br&gt;├─ pangi.db*&lt;br&gt;├─ secrets/ · logs/&lt;br&gt;└─ artifacts/ · backups/&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#B42318&quot;&gt;학습/실행 데이터와 Credential은 Git에 넣지 않는다.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#F79009;strokeWidth=3;fontSize=22;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;arcSize=10;" vertex="1" parent="p5-1"><mxGeometry x="1420" y="950" width="430" height="240" as="geometry"/></mxCell>

        <mxCell id="p5-rule" value="Directory Rule · domain은 framework-free · application이 Port를 소유 · adapters가 Port를 구현 · bootstrap.py만 구현을 조립 · UI는 REST/SSE 외에 SQLite에 직접 접근하지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9F5FF;strokeColor=#B692F6;strokeWidth=3;fontSize=19;fontStyle=1;fontColor=#53389E;arcSize=10;" vertex="1" parent="p5-1"><mxGeometry x="50" y="1240" width="1800" height="80" as="geometry"/></mxCell>
        <mxCell id="p5-test-rule" value="Test 배치 · Domain Unit → Application Unit(Fake Port) → Adapter Contract → SQLite/MCP Integration → Slack/API/UI E2E 순서로 경계를 검증한다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#98A2B3;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#344054;arcSize=10;" vertex="1" parent="p5-1"><mxGeometry x="50" y="1340" width="1800" height="65" as="geometry"/></mxCell>

        <mxCell id="p5-edge-root-entry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#667085;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="p5-1" source="p5-root" target="p5-entry"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
