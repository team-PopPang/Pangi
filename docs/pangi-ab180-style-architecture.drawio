  <diagram id="pangi-software-architecture" name="D. 코드 의존성 View">
    <mxGraphModel dx="1900" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="p4-0"/>
        <mxCell id="p4-1" parent="p4-0"/>

        <mxCell id="p4-title" value="View D · Pangi 코드 의존성과 Port 경계" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#17212B;" vertex="1" parent="p4-1"><mxGeometry x="50" y="35" width="1100" height="55" as="geometry"/></mxCell>
        <mxCell id="p4-subtitle" value="하나의 결정 · 배포=Modular Monolith · 의존 규칙=Clean · 통합 경계=Hexagonal Ports &amp; Adapters" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21;fontColor=#475467;" vertex="1" parent="p4-1"><mxGeometry x="52" y="92" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="p4-legend" value="&lt;b&gt;이 페이지가 답하는 질문&lt;/b&gt;&lt;br&gt;어느 Package가 어느 Package를 Import할 수 있는가?&lt;br&gt;&lt;font color=&quot;#6941C6&quot;&gt;보라 점선 = 소스 코드 의존 방향(항상 안쪽)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9F5FF;strokeColor=#D6BBFB;strokeWidth=2;fontSize=16;align=left;spacingLeft=16;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="1270" y="35" width="580" height="100" as="geometry"/></mxCell>

        <mxCell id="p4-inbound-boundary" value="Driving Clients / Inbound Adapters&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;외부 입력을 Application Contract로 변환&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF8FF;strokeColor=#84CAFF;strokeWidth=2;verticalAlign=top;align=left;spacingTop=16;spacingLeft=18;fontSize=22;fontStyle=1;fontColor=#175CD3;arcSize=8;" vertex="1" parent="p4-1"><mxGeometry x="50" y="170" width="390" height="700" as="geometry"/></mxCell>
        <mxCell id="p4-dashboard" value="React Admin Dashboard&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;별도 TS Client · OpenAPI/SSE Contract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E90FA;strokeWidth=2;fontSize=20;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="90" y="275" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="p4-api" value="FastAPI Routes&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;HTTP DTO · Auth · Controller 역할&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E90FA;strokeWidth=2;fontSize=20;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="90" y="395" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="p4-slack" value="Slack Adapter&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;Event/Ack/Thread → RunRequest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E90FA;strokeWidth=2;fontSize=20;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="90" y="515" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="p4-cli" value="CLI · Scheduler · Eval Adapter&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;모두 같은 Inbound Port 호출&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E90FA;strokeWidth=2;fontSize=20;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="90" y="635" width="310" height="105" as="geometry"/></mxCell>
        <mxCell id="p4-inbound-path" value="src/pangi/adapters/inbound/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1E9FF;strokeColor=#2E90FA;strokeWidth=2;fontSize=17;fontStyle=1;fontFamily=Courier New;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="90" y="780" width="310" height="55" as="geometry"/></mxCell>

        <mxCell id="p4-app-boundary" value="Application Core · Port 소유자" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9F5FF;strokeColor=#B692F6;strokeWidth=3;verticalAlign=top;align=left;spacingTop=16;spacingLeft=18;fontSize=24;fontStyle=1;fontColor=#6941C6;arcSize=8;" vertex="1" parent="p4-1"><mxGeometry x="480" y="170" width="920" height="700" as="geometry"/></mxCell>
        <mxCell id="p4-usecases" value="Application Use Cases&lt;br&gt;&lt;font style=&quot;font-size:16px;font-weight:normal&quot;&gt;run_request · run_skill · manage_connection · manage_schedule · run_eval · manage_memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D7FE;strokeColor=#7F56D9;strokeWidth=2;fontSize=22;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="690" y="240" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="p4-inport" value="Inbound Ports&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;RunUseCase&lt;br&gt;SkillUseCase&lt;br&gt;AdminUseCase&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F56D9;strokeWidth=2;fontSize=20;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="520" y="420" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="p4-domain" value="Pure Domain Core&lt;br&gt;&lt;font style=&quot;font-size:17px;font-weight:normal&quot;&gt;Run · Skill · Schedule · Connection&lt;br&gt;Eval · Memory&lt;br&gt;Entity · Value Object · Policy · Event&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EBFF;strokeColor=#6941C6;strokeWidth=4;fontSize=24;fontStyle=1;arcSize=12;" vertex="1" parent="p4-1"><mxGeometry x="760" y="395" width="370" height="205" as="geometry"/></mxCell>
        <mxCell id="p4-outport" value="Outbound Ports&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;ModelPort&lt;br&gt;ConnectionPort&lt;br&gt;StoragePort&lt;br&gt;Secret/Event Port&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F56D9;strokeWidth=2;fontSize=20;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="1190" y="410" width="180" height="175" as="geometry"/></mxCell>
        <mxCell id="p4-services" value="Application Services&lt;br&gt;&lt;font style=&quot;font-size:16px;font-weight:normal&quot;&gt;Guardrails · Orchestrator · Plan Validator · Execution Engine&lt;br&gt;Result Reducer · Skill Compiler · Policy Engine · Analytics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D7FE;strokeColor=#7F56D9;strokeWidth=2;fontSize=22;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="650" y="650" width="590" height="130" as="geometry"/></mxCell>
        <mxCell id="p4-app-path" value="src/pangi/application/  →  src/pangi/domain/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDD6FE;strokeColor=#7F56D9;strokeWidth=2;fontSize=17;fontStyle=1;fontFamily=Courier New;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="690" y="805" width="500" height="45" as="geometry"/></mxCell>

        <mxCell id="p4-outbound-boundary" value="Driven / Outbound Adapters&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;Application Port의 교체 가능한 구현&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#6CE9A6;strokeWidth=2;verticalAlign=top;align=left;spacingTop=16;spacingLeft=18;fontSize=23;fontStyle=1;fontColor=#027A48;arcSize=8;" vertex="1" parent="p4-1"><mxGeometry x="1440" y="170" width="410" height="700" as="geometry"/></mxCell>
        <mxCell id="p4-models" value="Model Providers&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;OpenAI · Bedrock · Request Mapper&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12B76A;strokeWidth=2;fontSize=20;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="1480" y="285" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="p4-mcp" value="MCP Clients&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;stdio · Streamable HTTP · OAuth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12B76A;strokeWidth=2;fontSize=20;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="1480" y="405" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="p4-sqlite" value="SQLite Persistence&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;Repository · Unit of Work · Migration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12B76A;strokeWidth=2;fontSize=20;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="1480" y="525" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="p4-secret" value="Secrets · Telemetry&lt;br&gt;&lt;font style=&quot;font-size:15px;font-weight:normal&quot;&gt;Keyring/Vault · Log · Metric · Trace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12B76A;strokeWidth=2;fontSize=20;fontStyle=1;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="1480" y="645" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="p4-outbound-path" value="src/pangi/adapters/outbound/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FADF;strokeColor=#12B76A;strokeWidth=2;fontSize=17;fontStyle=1;fontFamily=Courier New;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="1480" y="780" width="330" height="55" as="geometry"/></mxCell>

        <mxCell id="p4-bootstrap" value="Composition Root · bootstrap.py&lt;br&gt;&lt;font style=&quot;font-size:16px;font-weight:normal&quot;&gt;유일하게 모든 구현을 알고 Port ↔ Adapter를 조립&lt;br&gt;Config 검증 → Migration → Registry → Runtime 시작&lt;br&gt;&lt;b&gt;Domain/Application은 bootstrap을 Import하지 않는다.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F79009;strokeWidth=3;fontSize=22;fontStyle=1;align=left;spacingLeft=18;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="50" y="930" width="570" height="235" as="geometry"/></mxCell>
        <mxCell id="p4-deploy" value="배포 형식 · Modular Monolith&lt;br&gt;&lt;font style=&quot;font-size:16px;font-weight:normal&quot;&gt;하나의 Python wheel · 기본 단일 Process · SQLite&lt;br&gt;Module 경계는 Import Rule과 Port Contract로 강제&lt;br&gt;1.0에서 Network Microservice 분리는 하지 않음&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0BA5EC;strokeWidth=3;fontSize=22;fontStyle=1;align=left;spacingLeft=18;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="665" y="930" width="570" height="235" as="geometry"/></mxCell>
        <mxCell id="p4-mvc" value="MVC인가? · 전체 시스템은 MVC 아님&lt;br&gt;&lt;font style=&quot;font-size:16px;font-weight:normal&quot;&gt;FastAPI Route는 Controller와 비슷하지만 Domain Logic 없음&lt;br&gt;React UI는 View이지만 독립 Feature/API 구조 사용&lt;br&gt;Model 하나에 DB·업무 규칙을 합치는 Active Record를 쓰지 않음&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F3;strokeColor=#F63D68;strokeWidth=3;fontSize=22;fontStyle=1;align=left;spacingLeft=18;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="1280" y="930" width="570" height="235" as="geometry"/></mxCell>

        <mxCell id="p4-call-note" value="Runtime 호출은 바깥 → 안쪽 → 바깥(Slack/API → Use Case → Port → MCP/SQLite)으로 흐른다. 하지만 소스 Import 의존성은 Adapter → Application → Domain 방향만 허용한다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#98A2B3;strokeWidth=2;fontSize=19;fontStyle=1;fontColor=#344054;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="50" y="1210" width="1800" height="80" as="geometry"/></mxCell>
        <mxCell id="p4-rules" value="Import Rules  ① domain: 표준 라이브러리 중심  ② application: domain + 자신이 소유한 port  ③ adapter: application/domain  ④ adapter 간 직접 Import 금지  ⑤ bootstrap만 전체 조립" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9F5FF;strokeColor=#B692F6;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#53389E;arcSize=10;" vertex="1" parent="p4-1"><mxGeometry x="50" y="1310" width="1800" height="75" as="geometry"/></mxCell>

        <mxCell id="p4-edge-api-port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6941C6;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="p4-1" source="p4-api" target="p4-inport"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-edge-slack-port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6941C6;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="p4-1" source="p4-slack" target="p4-inport"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-edge-cli-port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6941C6;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="p4-1" source="p4-cli" target="p4-inport"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="688"/><mxPoint x="610" y="688"/></Array></mxGeometry></mxCell>
        <mxCell id="p4-edge-inport-usecase" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6941C6;strokeWidth=2;dashed=1;entryX=0;entryY=0.5;" edge="1" parent="p4-1" source="p4-inport" target="p4-usecases"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-edge-usecase-domain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6941C6;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="p4-1" source="p4-usecases" target="p4-domain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-edge-services-domain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6941C6;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="p4-1" source="p4-services" target="p4-domain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-edge-model-port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6941C6;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.15;" edge="1" parent="p4-1" source="p4-models" target="p4-outport"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-edge-mcp-port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6941C6;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.4;" edge="1" parent="p4-1" source="p4-mcp" target="p4-outport"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-edge-sqlite-port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6941C6;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.68;" edge="1" parent="p4-1" source="p4-sqlite" target="p4-outport"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-edge-secret-port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6941C6;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="p4-1" source="p4-secret" target="p4-outport"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="693"/><mxPoint x="1280" y="693"/></Array></mxGeometry></mxCell>
